<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg_gradient">

    <!-- Decorative top-right accent circle (subtle glow) -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/splash_glow_circle"
        android:alpha="0.12" />

    <!-- Decorative bottom-left accent circle -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"
        android:background="@drawable/splash_glow_circle"
        android:alpha="0.08" />

    <!-- Center Content -->
    <LinearLayout
        android:id="@+id/layout_center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Big App Logo with Glow -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_glow_circle"
                android:alpha="0.25" />

            <ImageView
                android:id="@+id/img_splash_logo"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_vector"
                android:alpha="0" />
        </FrameLayout>

        <!-- App Title -->
        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:alpha="0" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Manage, Create &amp; Export Invoices Daily"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.02"
            android:alpha="0" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progress_splash"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="40dp"
            android:indeterminateTint="@color/accent_gold"
            android:alpha="0" />
    </LinearLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_splash_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v2.0.0 • Daily Invoicer"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.08"
            android:alpha="0" />

        <TextView
            android:id="@+id/tv_splash_credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="by devvrushabh"
            android:textColor="@color/accent_gold"
            android:textSize="10sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.1"
            android:alpha="0" />
    </LinearLayout>

</RelativeLayout>
